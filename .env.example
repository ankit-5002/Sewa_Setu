# Sewa Setu Portal - Environment Configuration Template
# Copy this file to .env and set your own secure credentials.
# WARNING: NEVER commit your actual .env file to version control.

# Admin Login Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Application Settings
PUBLIC_BASE_URL=http://localhost:8000
SECRET_KEY=change_me_to_a_random_secure_hex_string
PORT=8000

# PostgreSQL Database URL (Supabase, Cloud, or Local)
# Note: For Supabase, use the IPv4 Connection Pooler URI (Session Mode on port 5432/6543)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
